"""Filter Enhancement (过滤器增强) — placeholder mode for regex-filtered messages.

Port of the filter-enhancement patch set from ljili1/NagramXF (branch 12.10.1,
commits 67b0380c "feat(filters): port AyuFilter regex message filtering from 12.9.2"
and 533af9af "fix(filters): remove stray brace in MessageHelper filter match text")
to the Keeperorowner/NagramXF Python plugin SDK (exteraGram-style).

Feature parity with the original Java patch:
  1. Hidden-by-filter messages render as a tappable placeholder bar (view type -1001)
     instead of vanishing; tap reveals the original message(s) in place.
  2. Consecutive placeholders merge into a single "N messages hidden" bar; one tap
     reveals the whole run.
  3. Long-press a placeholder shows WHY the message was hidden (matched text fragments).
  4. A floating "Collapse" pill appears while any filtered message is revealed and
     collapses all of them back.
  5. Link-preview (webpage) content participates in regex matching, so rules that
     target URLs shown only inside link previews actually hit.
  6. Editing a message re-evaluates its filter verdict immediately (per-message cache
     invalidation on content change) instead of after reopening the chat.
  7. Toggling any filter option refreshes open chats immediately (invalidateFilteredCache
     now also posts NotificationCenter.regexFiltersUpdated).
  8. The upstream shadow-ban peer-chain hide (via_bot / fwd_from chains) is disabled,
     matching the enhancement's removal of isShadowBannedPeerChain; a switch restores it.

The plugin only hooks Java methods (Xposed-style, via the host's PyMethodHook);
it ships no Java code and adds no resources. All placeholder strings are bundled
below (zh-CN + en) because plugins cannot register R.string resources.
"""

__id__ = "filter_enhancement"
__name__ = "Filter Enhancement"
__version__ = "1.0.4"
__author__ = "ljili1"
__description__ = (
    "Regex filter enhancement: tappable placeholders for hidden messages, merged "
    "runs, tap-to-reveal, long-press filter reason, collapse pill, link-preview "
    "matching, instant refresh on edit/toggle."
)
__min_version__ = "12.2.10"

import re

from java import jclass

from base_plugin import BasePlugin, XposedHook
import hook_utils
from android_utils import (
    dp,
    log,
    run_on_ui_thread,
    get_string,
    OnClickListener,
    OnLongClickListener,
    R,
)
from ui.settings import Header, Divider, Switch, Text
from ui.alert import AlertDialogBuilder

# ---------------------------------------------------------------------------
# Java class references (resolved at import; all exist in the host app)
# ---------------------------------------------------------------------------
AyuFilter = jclass("tw.nekomimi.nekogram.filters.AyuFilter")
NaConfig = jclass("xyz.nextalone.nagram.NaConfig")
ChatObject = jclass("org.telegram.messenger.ChatObject")
NotificationCenter = jclass("org.telegram.messenger.NotificationCenter")
UserConfig = jclass("org.telegram.messenger.UserConfig")
LocaleController = jclass("org.telegram.messenger.LocaleController")
AndroidUtilities = jclass("org.telegram.messenger.AndroidUtilities")
Theme = jclass("org.telegram.ui.ActionBar.Theme")
LayoutHelper = jclass("org.telegram.ui.Components.LayoutHelper")
RecyclerListViewHolder = jclass("org.telegram.ui.Components.RecyclerListView$Holder")
RecyclerViewLayoutParams = jclass("androidx.recyclerview.widget.RecyclerView$LayoutParams")
FrameLayout = jclass("android.widget.FrameLayout")
FrameLayoutParams = jclass("android.widget.FrameLayout$LayoutParams")
TextView = jclass("android.widget.TextView")
Gravity = jclass("android.view.Gravity")
View = jclass("android.view.View")
TypedValue = jclass("android.util.TypedValue")
JavaSystem = jclass("java.lang.System")
# Chaquopy default-boxes Python int as java.lang.Long when the target type is
# Object. XposedBridge unboxes hook results with an (Integer) cast for int-returning
# methods, so setResult() MUST receive an explicitly constructed Integer — passing a
# bare Python int throws ClassCastException inside every layout pass and blanks the
# message list (fixed in v1.0.2).
JInteger = jclass("java.lang.Integer")
JBoolean = jclass("java.lang.Boolean")
JLong = jclass("java.lang.Long")

VIEW_TYPE_FILTER_PLACEHOLDER = -1001  # mirrors the Java patch; -1000 stays "fully hidden"

