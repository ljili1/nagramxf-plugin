# ---------------------------------------------------------------------------
# 路由表
# ---------------------------------------------------------------------------
# 标签派生：把「哪个 DC」编码进 Host 首段，但不用固定词汇（去指纹）
# ---------------------------------------------------------------------------
_B32_DIGITS = "234567"
_B32_LETTERS = "abcdef"
_CUSTOM_LABEL_OK = "abcdefghijklmnopqrstuvwxyz0123456789-"


def _label_from_mac(mac, length=DERIVED_LABEL_LEN):
    """32 字节摘要 -> 小写 base32 截断，首字符强制为字母（DNS 标签要求）。"""
    body = base64.b32encode(mac).decode("ascii").lower().rstrip("=")[:max(1, int(length))]
    head = body[0]
    if head in _B32_DIGITS:
        head = _B32_LETTERS[_B32_DIGITS.index(head)]
    return head + body[1:]


def derive_label(domain, dc, salt="", length=DERIVED_LABEL_LEN):
    """由 域名 + 盐值 + DC 确定性派生一个无意义标签。

    同一个 (域名, 盐值) 永远得到同一组标签，所以 DNS 只需配一次。
    盐值留空时只用域名派生（默认）：不同域名天然不同，且重启/重装都不变；
    填了盐值则再换一套标签（旧 DNS 记录立即失效，需同步重配）。
    """
    key = ("nagramxf-ws-proxy|%s|%s" % (domain or "", salt or "")).encode("utf-8")
    mac = hmac.new(key, ("dc%d" % dc).encode("ascii"), hashlib.sha256).digest()
    return _label_from_mac(mac, length)


def build_labels(domain, mode=0, salt="", custom=""):
    """返回 {dc: label}。label 只含 a-z0-9 且首字符为字母，可直接作为 DNS 主机名。"""
    labels = {}
    try:
        mode = int(mode)
    except Exception:
        mode = 0
    if mode == 1:
        return dict(LEGACY_LABELS)
    if mode == 2:
        items = [x.strip().lower() for x in (custom or "").replace(",", " ").split()
                 if x.strip()]
        for dc, name in zip(LABEL_DOMAIN_DCS, items):
            clean = "".join(ch for ch in name if ch in _CUSTOM_LABEL_OK).strip("-")
            if clean:
                labels[dc] = clean
    # 派生模式，或自定义模式下没填够的 DC：一律用派生值补齐
    used = set(labels.values())
    for dc in LABEL_DOMAIN_DCS:
        if dc in labels:
            continue
        name = derive_label(domain, dc, salt)
        bump = 0
        while name in used:            # 理论上不会发生，纯防御
            bump += 1
            name = derive_label(domain, dc, "%s#%d" % (salt, bump))
        labels[dc] = name
        used.add(name)
    return labels


def build_routes(domain, labels=None):
    """返回 (exact_table, v6_prefix_table)。

    labels: {dc: 子域首段}，缺省用兼容标签（pluto/venus/...）。

    exact_table 的键包含两种：
      - 精确主机（IPv4 点分串 / IPv6 压缩串）；
      - 截尾前缀（如 "149.154.167.5"、"91.108.4."），
        由「截尾 0-3 个字符」查表算法命中。
    v6_prefix_table 对 5 个 DC 的 /64 都放前缀键（test 精确行优先命中）。
    """
    t = {}
    labels = labels if isinstance(labels, dict) and labels else DC_SUBDOMAINS

    def label_of(dc):
        return labels.get(dc) or DC_SUBDOMAINS[dc]

    def put(key, dc):
        t[key] = "%s.%s" % (label_of(dc), domain)

    def put6(addr, dc):
        put(ipaddress.IPv6Address(addr).compressed, dc)

    # media（权威地址，records.txt）
    put("149.154.175.50", 1)
    put("149.154.167.51", 2)
    put("95.161.76.100", 2)
    put("149.154.175.100", 3)
    put("149.154.167.91", 4)
    put("149.154.171.5", 5)
    put6("2001:b28:f23d:f001::a", 1)
    put6("2001:67c:4e8:f002::a", 2)
    put6("2001:b28:f23d:f003::a", 3)
    put6("2001:67c:4e8:f004::a", 4)
    put6("2001:b28:f23f:f005::a", 5)

    # proxy（上游 tcp2wsServer.setCdnDomain 的完整集合）
    put("149.154.175.5", 1)        # 前缀：.175.50-.59 均为 dc1
    put("149.154.161.144", 2)
    put("149.154.167.15", 2)
    put("149.154.167.5", 2)        # 前缀：.167.50-.59
    put("149.154.167.6", 2)        # 前缀：.167.60-.69
    put("149.154.167.7", 2)        # 前缀：.167.70-.79
    put("149.154.167.2", 2)        # 前缀：.167.20-.29
    put("149.154.167.41", 2)       # 修正：dc2，截尾算法进不到 .4，必须精确行
    put("91.108.4.", 4)            # dc4 独占段
    put("149.154.164.", 4)
    put("149.154.165.", 4)
    put("149.154.166.", 4)
    put("149.154.167.8", 4)
    put("149.154.167.9", 4)
    put("91.108.56.", 5)
    put("111.62.91.", 2)
    put6("2001:b28:f23d:f001::d", 1)
    put6("2001:67c:4e8:f002::d", 2)
    put6("2001:b28:f23d:f003::d", 3)
    put6("2001:67c:4e8:f004::d", 4)
    put6("2001:b28:f23f:f005::d", 5)

    # test DC（测试模式）
    put("149.154.175.10", 17)
    put("149.154.175.40", 17)
    put("149.154.167.40", 18)
    put("149.154.175.117", 19)
    put6("2001:b28:f23d:f001::e", 17)
    put6("2001:67c:4e8:f002::e", 18)
    put6("2001:b28:f23d:f003::e", 19)

    # IPv6 /64 前缀键。IPv6 /64 为单 DC 独占（prod 与 test 共用块，
    # 但 test 的 ::e 等已登记主机会被前面的截尾精确查表先命中，不受影响；
    # 未登记的 test 主机仅在测试模式下才可能出现，可接受）。
    # 真机案例：Telegram 下发 2001:67c:4e8:f002::b（dc2），表内仅有 ::a/::d/::e，
    # 截尾查不到即拒绝，必须靠 /64 回退覆盖。
    p6 = {}
    p6["2001:b28:f23d:f001"] = "%s.%s" % (label_of(1), domain)   # dc1
    p6["2001:67c:4e8:f002"] = "%s.%s" % (label_of(2), domain)   # dc2
    p6["2001:b28:f23d:f003"] = "%s.%s" % (label_of(3), domain)   # dc3
    p6["2001:67c:4e8:f004"] = "%s.%s" % (label_of(4), domain)   # dc4 独占
    p6["2001:b28:f23f:f005"] = "%s.%s" % (label_of(5), domain)   # dc5 独占

    return t, p6


def lookup_server(ip_str, table, v6_prefix):
    """按上游「截尾 0-3 字符」语义查表；IPv6 追加 /64 回退；查不到返回 None（拒绝）。"""
    s = ip_str
    if ":" in s:
        try:  # 归一化为压缩形式，与 Java getHostAddress() 对齐
            s = ipaddress.IPv6Address(s).compressed
        except Exception:
            pass
    for i in range(0, 4):
        key = s if i == 0 else s[:-i]
        hit = table.get(key)
        if hit is not None:
            return hit
    if ":" in s:
        try:
            groups = ipaddress.IPv6Address(s).exploded.split(":")[:4]
            p64 = ":".join(g.lstrip("0") or "0" for g in groups)
            return v6_prefix.get(p64)
        except Exception:
            return None
    return None


# ---------------------------------------------------------------------------
# 纯 Python AES-256-CTR（stdlib 无 AES；仅用于离线解码早夭隧道的入向头部，
# 每次只解 ≤64B，性能无关紧要。正确性由测试向量锁定）
# ---------------------------------------------------------------------------
_SBOX = (
    0x63,0x7c,0x77,0x7b,0xf2,0x6b,0x6f,0xc5,0x30,0x01,0x67,0x2b,0xfe,0xd7,0xab,0x76,
    0xca,0x82,0xc9,0x7d,0xfa,0x59,0x47,0xf0,0xad,0xd4,0xa2,0xaf,0x9c,0xa4,0x72,0xc0,
    0xb7,0xfd,0x93,0x26,0x36,0x3f,0xf7,0xcc,0x34,0xa5,0xe5,0xf1,0x71,0xd8,0x31,0x15,
    0x04,0xc7,0x23,0xc3,0x18,0x96,0x05,0x9a,0x07,0x12,0x80,0xe2,0xeb,0x27,0xb2,0x75,
    0x09,0x83,0x2c,0x1a,0x1b,0x6e,0x5a,0xa0,0x52,0x3b,0xd6,0xb3,0x29,0xe3,0x2f,0x84,
    0x53,0xd1,0x00,0xed,0x20,0xfc,0xb1,0x5b,0x6a,0xcb,0xbe,0x39,0x4a,0x4c,0x58,0xcf,
    0xd0,0xef,0xaa,0xfb,0x43,0x4d,0x33,0x85,0x45,0xf9,0x02,0x7f,0x50,0x3c,0x9f,0xa8,
    0x51,0xa3,0x40,0x8f,0x92,0x9d,0x38,0xf5,0xbc,0xb6,0xda,0x21,0x10,0xff,0xf3,0xd2,
    0xcd,0x0c,0x13,0xec,0x5f,0x97,0x44,0x17,0xc4,0xa7,0x7e,0x3d,0x64,0x5d,0x19,0x73,
    0x60,0x81,0x4f,0xdc,0x22,0x2a,0x90,0x88,0x46,0xee,0xb8,0x14,0xde,0x5e,0x0b,0xdb,
    0xe0,0x32,0x3a,0x0a,0x49,0x06,0x24,0x5c,0xc2,0xd3,0xac,0x62,0x91,0x95,0xe4,0x79,
    0xe7,0xc8,0x37,0x6d,0x8d,0xd5,0x4e,0xa9,0x6c,0x56,0xf4,0xea,0x65,0x7a,0xae,0x08,
    0xba,0x78,0x25,0x2e,0x1c,0xa6,0xb4,0xc6,0xe8,0xdd,0x74,0x1f,0x4b,0xbd,0x8b,0x8a,
    0x70,0x3e,0xb5,0x66,0x48,0x03,0xf6,0x0e,0x61,0x35,0x57,0xb9,0x86,0xc1,0x1d,0x9e,
    0xe1,0xf8,0x98,0x11,0x69,0xd9,0x8e,0x94,0x9b,0x1e,0x87,0xe9,0xce,0x55,0x28,0xdf,
    0x8c,0xa1,0x89,0x0d,0xbf,0xe6,0x42,0x68,0x41,0x99,0x2d,0x0f,0xb0,0x54,0xbb,0x16,
)


def _aes256_expand_key(key):
    """AES-256 密钥扩展，返回 15 个 16B 轮密钥的扁平 bytes（240B）。"""
    assert len(key) == 32
    nk, nr = 8, 14
    words = [bytearray(key[4 * i:4 * i + 4]) for i in range(nk)]
    rcon = 1
    for i in range(nk, 4 * (nr + 1)):
        temp = bytearray(words[i - 1])
        if i % nk == 0:
            temp = bytearray(_SBOX[b] for b in temp[1:] + temp[:1])
            temp[0] ^= rcon
            rcon = ((rcon << 1) ^ (0x11B if rcon & 0x80 else 0)) & 0xFF
        elif i % nk == 4:
            temp = bytearray(_SBOX[b] for b in temp)
        words.append(bytearray(a ^ b for a, b in zip(words[i - nk], temp)))
    return b"".join(bytes(w) for w in words)


def _aes_encrypt_block(round_keys, block):
    """单块 AES 加密（14 轮）。"""
    state = bytearray(block)

    def add_round_key(r):
        for i in range(16):
            state[i] ^= round_keys[16 * r + i]

    def sub_bytes():
        for i in range(16):
            state[i] = _SBOX[state[i]]

    def shift_rows():
        s = state
        s[1], s[5], s[9], s[13] = s[5], s[9], s[13], s[1]
        s[2], s[6], s[10], s[14] = s[10], s[14], s[2], s[6]
        s[3], s[7], s[11], s[15] = s[15], s[3], s[7], s[11]

    def mix_columns():
        for c in range(4):
            i = 4 * c
            a0, a1, a2, a3 = state[i], state[i + 1], state[i + 2], state[i + 3]
            x0, x1, x2, x3 = (a0 << 1) ^ (0x1B if a0 & 0x80 else 0), \
                             (a1 << 1) ^ (0x1B if a1 & 0x80 else 0), \
                             (a2 << 1) ^ (0x1B if a2 & 0x80 else 0), \
                             (a3 << 1) ^ (0x1B if a3 & 0x80 else 0)
            state[i]     = (x0 ^ (x1 ^ a1) ^ a2 ^ a3) & 0xFF
            state[i + 1] = (a0 ^ x1 ^ (x2 ^ a2) ^ a3) & 0xFF
            state[i + 2] = (a0 ^ a1 ^ x2 ^ (x3 ^ a3)) & 0xFF
            state[i + 3] = ((x0 ^ a0) ^ a1 ^ a2 ^ x3) & 0xFF

    add_round_key(0)
    for r in range(1, 14):
        sub_bytes(); shift_rows(); mix_columns(); add_round_key(r)
    sub_bytes(); shift_rows(); add_round_key(14)
    return bytes(state)


class Aes256Ctr(object):
    """AES-256-CTR 流（计数器 128bit 大端自增，与 OpenSSL/cryptography 一致）。
    加密解密同为 crypt()。"""

    def __init__(self, key, iv):
        self._rk = _aes256_expand_key(key)
        self._ctr = int.from_bytes(iv, "big")
        self._ks = b""
        self._ks_pos = 0

    def crypt(self, data):
        out = bytearray()
        for b in data:
            if self._ks_pos >= len(self._ks):
                self._ks = _aes_encrypt_block(
                    self._rk, (self._ctr & ((1 << 128) - 1)).to_bytes(16, "big"))
                self._ctr += 1
                self._ks_pos = 0
            out.append(b ^ self._ks[self._ks_pos])
            self._ks_pos += 1
        return bytes(out)


def obfs2_decode_incoming(init64, data):
    """用 tgnet 发来的 obfs2 init（线上前 64B）推导入向密钥并解密 data。

    线上 init 形态为 明文[0:56]+密文[56:64]，其 [8:56] 为明文随机段；
    入向（server->client）key/iv = reversed(init[8:56]) 的前 32B / 后 16B，
    密钥流从位置 0 开始（与 telethon ObfuscatedIO 一致，已经真链路验证）。
    init 不足 64B 时返回 None。
    """
    if len(init64) < 64:
        return None
    rev = init64[8:56][::-1]
    return Aes256Ctr(rev[:32], rev[32:48]).crypt(data)


def parse_abridged_err(plain, total_len):
    """若 plain 是完整 abridged 小包（长度自洽且总长匹配），返回传输错误码 int 或 0。"""
    if not plain:
        return 0
    n = plain[0]
    if n == 0x7F or n == 0 or 1 + n * 4 != total_len:
        return 0
    if n == 1 and len(plain) >= 5:
        return struct.unpack("<i", plain[1:5])[0]
    return -1  # 自洽但非错误包


# ---------------------------------------------------------------------------
# 纯 stdlib 的 WebSocket 客户端（仅实现所需子集：二进制帧、ping/pong、close）
# ---------------------------------------------------------------------------
#
# 域名解析：直接用宿主自带的 DNS 选择器，插件不再自己实现一份 DoH。
#   tw.nekomimi.nekogram.utils.DnsFactory（Nekogram）
#   由 App 设置 → 通用 →「DNS 解析器」(DNS Resolver) 控制：
#     System / 自定义 DoH …, 自带 dnsjava 缓存，会按设备实际的 IPv4/IPv6 能力
#     决定查 A 还是 AAAA，并在 DoH 失败后回退系统 DNS。
#   自己再写一份 DoH 只会重复，也没法复刻 App 的策略（见 app_dns_lookup）。
#   系统 DNS 仅作为兜底保留：万一宿主版本没有 DnsFactory 这个类。
LAST_RESOLVE_SOURCE = "dns"   # "appdns" / "dns" / "cache"
LAST_DIAL_TRACE = ""           # 失败时记录「试过哪些地址、各自什么错」，一次把话说清
LAST_DIAL_IP = ""              # dial_tcp 最近一次 TCP 已连通的地址，供 ws_connect 失败时清缓存
BEST_ADDR_TTL = 120.0          # 上次连通的地址缓存 2 分钟，避免每次都重新解析
_best_addr = {}                # host -> (expire_ts, ip)
_best_lock = threading.Lock()

_ssl_ctx = {}                  # insecure -> SSLContext（复用，见 tls_context）
_ssl_ctx_lock = threading.Lock()
_app_dns_cache = {}            # host -> (expire_ts, tuple_of_ips)
_app_dns_lock = threading.Lock()
APP_DNS_TTL = 60.0

# ---- 隧道保活 / 地址退避 / 并发上限 --------------------------------------
# 真机日志里大量隧道在 age=11s~41s 时被上游 "unexpected eof" 掐断，而插件出向
# 在空闲期是零字节（只被动回 pong）。Cloudflare 回源到 Telegram 有 ~100s 空闲回收，
# 源站也会踢无活动连接，所以这里主动发 WS ping 保活。
KEEPALIVE_INTERVAL = 25.0      # 空闲多久发一次 ping（<=0 关闭保活）
KEEPALIVE_IDLE_LIMIT = 75.0    # 连续多久收不到任何字节就判定死链并关闭
# 同一地址连续拨号失败 N 次后冷却：不要再每次都先撞它一次
ADDR_FAIL_LIMIT = 2
ADDR_COOLDOWN = 30.0
_addr_fail = {}                # (host, ip) -> (fail_count, cooldown_until)
_addr_fail_lock = threading.Lock()
# 全局并发隧道上限（纯防御：避免上游异常时线程/隧道无界增长）
MAX_TUNNELS = 96

# App 自带的 DNS 选择器（Nekogram 的 DnsFactory；宿主没有这个类时为 None）
try:
    _DnsFactory = jclass("tw.nekomimi.nekogram.utils.DnsFactory")
except Exception:
    _DnsFactory = None


def tls_context(insecure=False):
    """复用 SSLContext。

    ws_connect() 原先每次拨号都调 ssl.create_default_context()，而它每次都要重新读取
    并解析整份系统 CA 库。真机日志里 30 秒出现过 5800 次拨号，这个开销很可观。
    复用同一个 context 还有个附带好处：TLS 会话票据有机会复用，握手少一个 RTT。
    """
    key = bool(insecure)
    with _ssl_ctx_lock:
        ctx = _ssl_ctx.get(key)
    if ctx is None:
        ctx = ssl._create_unverified_context() if key else ssl.create_default_context()
        with _ssl_ctx_lock:
            _ssl_ctx[key] = ctx
    return ctx


def _dnsfactory_lookup(host):
    """调一次 App 自带的 DnsFactory.lookup（@JvmStatic）。"""
    if _DnsFactory is None:
        return []
    out = []
    for a in _DnsFactory.lookup(host, False):
        try:
            ip = a.getHostAddress()
        except Exception:
            continue
        if ip and ip not in out:
            out.append(ip)
    return out


def app_dns_lookup(host, wait=1.5):
    """用 App 设置里的「DNS」选择器解析（系统 DNS / DoH / 自定义 DoH）。

    为什么优先用它，而不是插件自己再搞一套 DoH：
      * 它尊重用户在 App 里选的 DNS；
      * 它会按设备**实际的 IPv4/IPv6 能力**决定查 A 还是 AAAA ——
        本机 tgnet 全程 ipv6:0（纯 IPv4），正是这段逻辑该处理的场景，
        插件自己猜地址族只会白撞 ENETUNREACH；
      * 它自带 org.xbill 的 DNS 缓存，并会在 DoH 失败后回退系统 DNS。

    wait 秒内没结果就放弃本轮回退到其它路径；Java 调用在后台线程继续跑完，
    结果进它自己的缓存，下次拨号就能快速命中。
    """
    if _DnsFactory is None:
        return []
    now = time.time()
    with _app_dns_lock:
        hit = _app_dns_cache.get(host)
        if hit and hit[0] > now:
            return list(hit[1])
    box = {}

    def _run():
        try:
            box["ips"] = _dnsfactory_lookup(host)
        except Exception:
            box["ips"] = []

    t = threading.Thread(target=_run, name="wsproxy-appdns", daemon=True)
    t.start()
    t.join(max(0.2, wait))
    ips = box.get("ips") or []
    with _app_dns_lock:
        _app_dns_cache[host] = (time.time() + (APP_DNS_TTL if ips else 15.0), tuple(ips))
    return ips


def system_addrs(host, port):
    """系统 DNS 的解析结果，**IPv4 排在 IPv6 前面**。返回 (ips, error)。"""
    try:
        infos = socket.getaddrinfo(host, port, 0, socket.SOCK_STREAM)
    except Exception as e:
        return [], e
    seen = []
    for _fam, _type, _proto, _canon, sa in infos:
        if sa and sa[0] not in seen:
            seen.append(sa[0])
    v4 = [a for a in seen if ":" not in a]
    v6 = [a for a in seen if ":" in a]
    return v4 + v6, None


def _remember_addr(host, ip):
    with _best_lock:
        _best_addr[host] = (time.time() + BEST_ADDR_TTL, ip)


def _forget_addr(host, ip):
    """拨号失败时清掉缓存：下次换别的地址，不再先浪费一次超时。"""
    with _best_lock:
        hit = _best_addr.get(host)
        if hit and hit[1] == ip:
            _best_addr.pop(host, None)


def _cached_addr(host):
    with _best_lock:
        hit = _best_addr.get(host)
    if hit and hit[0] > time.time():
        return hit[1]
    return None


def _addr_in_cooldown(host, ip):
    """同一地址连续失败多次后，短时间内别再试它。"""
    with _addr_fail_lock:
        rec = _addr_fail.get((host, ip))
    return bool(rec and rec[1] > time.time())


def _addr_mark_ok(host, ip):
    with _addr_fail_lock:
        _addr_fail.pop((host, ip), None)


def _addr_mark_fail(host, ip):
    now = time.time()
    with _addr_fail_lock:
        cnt = _addr_fail.get((host, ip), (0, 0.0))[0] + 1
        until = now + ADDR_COOLDOWN if (ADDR_FAIL_LIMIT > 0
                                         and cnt >= ADDR_FAIL_LIMIT) else 0.0
        _addr_fail[(host, ip)] = (cnt, until)
        # 防止字典无界增长
        if len(_addr_fail) > 256:
            for k in [k for k, v in _addr_fail.items() if v[1] and v[1] < now]:
                _addr_fail.pop(k, None)
    return cnt


def dial_tcp(host, port, timeout):
    """连 host:port，返回已连接的 socket。三层，共用同一条时间预算：

      1. 复用上次连通的地址（缓存 2 分钟）——省掉反复解析；
      2. **宿主自带的 DNS 选择器**（DnsFactory，见 app_dns_lookup）：
         尊重 App 里的「DNS 解析器」设置，并按设备实际的 IPv4/IPv6 能力选 A/AAAA；
      3. 系统 DNS 兜底，**IPv4 排在 IPv6 前面**（实测机型纯 IPv4，tgnet 全程 ipv6:0，
         而 Cloudflare 代理记录同时有 A 和 AAAA，IPv6 排前面只会白撞 ENETUNREACH）。

    解析全部交给宿主的解析器，插件不再自己实现 DoH：
    App 里把「DNS 解析器」从 System 改成任一 DoH 项，解析就会走 DoH。
    """
    global LAST_RESOLVE_SOURCE, LAST_DIAL_TRACE, LAST_DIAL_IP
    deadline = time.time() + max(1.0, timeout)
    errors = []
    tried = set()

    def _try(ip, source):
        # 注意：嵌套函数里必须再声明一次 global，否则下面的赋值只会创建局部变量，
        # 模块级的 LAST_RESOLVE_SOURCE / LAST_DIAL_TRACE 永远不更新（诊断会全部失效）。
        global LAST_RESOLVE_SOURCE, LAST_DIAL_TRACE, LAST_DIAL_IP
        if ip in tried:
            return None
        tried.add(ip)
        if _addr_in_cooldown(host, ip):
            errors.append("%s: skipped(cooldown)" % ip)
            return None
        left = deadline - time.time()
        if left <= 0.2:
            errors.append("%s: skipped(budget)" % ip)
            return None
        try:
            sock = socket.create_connection((ip, port), timeout=left)
            try:
                # MTProto 全是小包，Nagle 会额外攒最多 ~40ms 才发；代理场景必须关掉
                sock.setsockopt(socket.IPPROTO_TCP, socket.TCP_NODELAY, 1)
            except Exception:
                pass
        except Exception as e:
            errors.append("%s: %s" % (ip, str(e)[:60]))
            _forget_addr(host, ip)
            _addr_mark_fail(host, ip)
            return None
        _remember_addr(host, ip)
        _addr_mark_ok(host, ip)
        LAST_RESOLVE_SOURCE = source
        LAST_DIAL_TRACE = "%s:%s" % (source, ip)
        LAST_DIAL_IP = ip
        return sock

    cached = _cached_addr(host)
    if cached:
        sock = _try(cached, "cache")
        if sock is not None:
            return sock

    # 优先用 App 自带的 DNS 选择器（尊重 App 的 DNS 设置，并按设备能力选 A/AAAA）
    app_ips = app_dns_lookup(host, wait=min(1.5, max(0.3, (deadline - time.time()) * 0.5)))
    for ip in app_ips:
        sock = _try(ip, "appdns")
        if sock is not None:
            return sock

    # 兜底：系统 DNS（宿主没有 DnsFactory，或 App 的解析器没给出结果时）
    addrs, gerr = system_addrs(host, port)
    if gerr is not None:
        errors.append("getaddrinfo: %s" % str(gerr)[:60])
    for ip in addrs:
        sock = _try(ip, "dns")
        if sock is not None:
            return sock

    LAST_DIAL_TRACE = "; ".join(errors[:4]) or ("no address for %s" % host)
    if gerr is not None and not addrs:
        raise gerr
    raise OSError("ws dial %s failed: %s" % (host, LAST_DIAL_TRACE))


class WsError(Exception):
    pass


def unreachable_hint(err):
    """ENETUNREACH / EHOSTUNREACH 之类：解析成功但根本连不出去。

    这种最容易被误判成「DNS 坏了」——其实 DNS 是通的（没抛 gaierror），
    只是返回了不可路由的地址（典型就是本机 DNS 被污染）。
    """
    text = str(err or "").lower()
    return (isinstance(err, OSError) and getattr(err, "errno", None) in (101, 113)
            ) or "network is unreachable" in text or "no route to host" in text


def ws_connect(host, use_tls, user_agent, conn_hash, timeout=3.0, insecure=False, port=None):
    """与 wss://host/api 建立 WebSocket，返回 (socket, 握手时多读的残留字节)。

    任何失败路径都会关闭已打开的 socket，避免 fd 泄漏。

    失败时还会清掉「上次连通地址」缓存：TCP 连得上、但 TLS/Upgrade 阶段失败时，
    那个地址同样已经不可用，不清掉下次拨号还会先撞它一次（真机日志里的
    「ws dial … 超时：cache:172.67.159.72」就是这么来的）。
    """
    global LAST_DIAL_IP
    if port is None:
        port = 443 if use_tls else 80
    sock = None
    LAST_DIAL_IP = ""
    try:
        raw = dial_tcp(host, port, timeout)
        if use_tls:
            sock = tls_context(insecure).wrap_socket(raw, server_hostname=host)
        else:
            sock = raw
        sock.settimeout(timeout)

        key = base64.b64encode(os.urandom(16)).decode("ascii")
        req = (
            "GET /api HTTP/1.1\r\n"
            "Host: %s\r\n"
            "Upgrade: websocket\r\n"
            "Connection: Upgrade\r\n"
            "Sec-WebSocket-Key: %s\r\n"
            "Sec-WebSocket-Version: 13\r\n"
            "Sec-WebSocket-Protocol: binary\r\n"
            "User-Agent: %s\r\n"
            "Conn-Hash: %s\r\n"
            "\r\n"
        ) % (host, key, user_agent, conn_hash)
        sock.sendall(req.encode("ascii"))

        # 读响应头（上限 16 KB，防异常对端）。
        # 注意：对端可能把 101 响应头与首批 WS 帧放在同一个 TCP 段里，
        # 必须保留 \r\n\r\n 之后的残留字节并交还给帧解析器，不能丢弃。
        resp = b""
        while b"\r\n\r\n" not in resp:
            chunk = sock.recv(4096)
            if not chunk:
                raise WsError("eof during handshake")
            resp += chunk
            if len(resp) > 16384:
                raise WsError("handshake response too large")
        head, leftover = resp.split(b"\r\n\r\n", 1)
        try:
            status_line = head.split(b"\r\n", 1)[0].decode("latin-1")
            status_code = int(status_line.split(" ", 2)[1])
        except Exception:
            raise WsError("bad handshake response: %r" % head[:80])
        if status_code != 101:
            raise WsError("handshake rejected: HTTP %d" % status_code)

        sock.settimeout(None)  # 进入长连接模式，阻塞读
        return sock, leftover
    except Exception:
        if sock is not None:
            try:
                sock.close()
            except Exception:
                pass
        # 走到这里说明本次拨号整体失败（可能是 TLS/Upgrade 阶段），
        # 那么 dial_tcp 刚记住的那个地址对当前网络也不可用，一并清掉。
        if LAST_DIAL_IP:
            try:
                _forget_addr(host, LAST_DIAL_IP)
                _addr_mark_fail(host, LAST_DIAL_IP)
            except Exception:
                pass
        raise


def _ws_mask(payload, mask):
    """给 WebSocket 载荷套/揭掩码（客户端帧必须带 mask，服务端帧不带）。

    等价于 bytes(b ^ mask[i % 4] for i, b in enumerate(payload))，但用大整数
    按 4 字节整块 XOR 一次算完：真机实测 256 KB 帧从 23.1 ms 降到 0.9 ms（约 25x），
    直接把逐字节 Python 循环那个 ~11 MB/s 的吞吐天花板抬掉（下载大文件时才看得出来）。
    mask 已经是 4 字节的 bytes。
    """
    n = len(payload)
    if not n:
        return b""
    if len(mask) != 4:
        mask = (mask + b"\x00\x00\x00\x00")[:4]
    if n <= 4:
        return bytes(a ^ mask[i] for i, a in enumerate(payload))
    key = mask * ((n + 3) // 4)
    return (int.from_bytes(payload, "big")
            ^ int.from_bytes(key[:n], "big")).to_bytes(n, "big")


def _recv_exact(sock, n):
    buf = b""
    while len(buf) < n:
        chunk = sock.recv(n - len(buf))
        if not chunk:
            raise WsError("unexpected eof")
        buf += chunk
    return buf


class WsConn(object):
    """封装一条已建立的 WebSocket：发送加锁（数据帧与 pong 会并发）。

    prebuffer：握手阶段多读的字节（101 响应头之后同段的 WS 帧），
    在 recv_message 中优先消费。
    """

    def __init__(self, sock, prebuffer=b""):
        self.sock = sock
        self._buf = bytearray(prebuffer)
        self.send_lock = threading.Lock()
        self.closed = False
        # 最近一次「收到任何帧」的时间（含 pong）：保活线程用它判断死链。
        # 放在这里而不是只记数据帧——服务端回 pong 同样证明链路是活的。
        self.last_read = time.time()

    def _read_exact(self, n):
        while len(self._buf) < n:
            chunk = self.sock.recv(max(4096, n - len(self._buf)))
            if not chunk:
                raise WsError("unexpected eof")
            self._buf += chunk
        out = bytes(self._buf[:n])
        del self._buf[:n]
        return out

    def _send_frame(self, opcode, payload):
        # 客户端帧必须带 mask
        header = bytearray()
        header.append(0x80 | opcode)
        length = len(payload)
        if length < 126:
            header.append(0x80 | length)
        elif length <= 0xFFFF:
            header.append(0x80 | 126)
            header += struct.pack(">H", length)
        else:
            header.append(0x80 | 127)
            header += struct.pack(">Q", length)
        mask = os.urandom(4)
        header += mask
        masked = _ws_mask(payload, mask)
        with self.send_lock:
            if self.closed:
                raise WsError("ws closed")
            self.sock.sendall(bytes(header) + masked)

    def send_binary(self, data):
        self._send_frame(0x2, data)

    def send_pong(self, payload):
        # 收帧线程里回 pong：连接正在关闭时写失败是正常的，
        # 不能让它把 recv_message 打穿（keepalive 与 close 会并发）。
        try:
            self._send_frame(0xA, payload)
        except Exception:
            pass

    def send_ping(self):
        self._send_frame(0x9, b"")

    def send_close(self):
        try:
            self._send_frame(0x8, b"")
        except Exception:
            pass

    def recv_message(self):
        """返回 (kind, payload)：kind 为 'data' / 'closed'（对端 close 帧）。
        自动处理分片、ping、pong；连接异常抛异常。"""
        fragments = []
        while True:
            hdr = self._read_exact(2)
            fin = hdr[0] & 0x80
            opcode = hdr[0] & 0x0F
            masked = hdr[1] & 0x80
            length = hdr[1] & 0x7F
            if length == 126:
                length = struct.unpack(">H", self._read_exact(2))[0]
            elif length == 127:
                length = struct.unpack(">Q", self._read_exact(8))[0]
            mask = self._read_exact(4) if masked else None
            payload = self._read_exact(length) if length else b""
            self.last_read = time.time()
            if mask:
                payload = _ws_mask(payload, mask)

            if opcode == 0x8:  # close
                return "closed", payload
            if opcode == 0x9:  # ping -> pong
                self.send_pong(payload)
                continue
            if opcode == 0xA:  # pong
                continue
            if opcode in (0x0, 0x1, 0x2):  # continuation / text / binary
                fragments.append(payload)
                if fin:
                    return "data", b"".join(fragments)
                continue
            # 未知 opcode：按规范应失败
            raise WsError("unknown opcode %d" % opcode)

    def close(self):
        if not self.closed:
            self.closed = True
            try:
                self.send_close()
            except Exception:
                pass
            try:
                self.sock.close()
            except Exception:
                pass


# ---------------------------------------------------------------------------
# SOCKS5 服务端（只实现 CONNECT；无认证 / RFC1929 透传接受）
# ---------------------------------------------------------------------------
class Relay(object):
    def __init__(self, logger):
        self.table = {}
        self.v6_prefix = {}
        self.domain = ""
        self.labels = dict(DC_SUBDOMAINS)
        self.use_tls = True
        self.conn_hash = DEFAULT_CONN_HASH
        self.user_agent = PLUGIN_UA
        self.insecure_tls = False
        self.port = DEFAULT_PORT

        self._server_sock = None
        self._accept_thread = None
        self._stopping = threading.Event()
        self._lock = threading.Lock()
        self._tunnels = set()  # (client_sock, WsConn) 存活隧道，stop 时统一拆除
        self.tunnels_open = 0
        self.tunnels_total = 0
        self.last_error = ""
        # 拨号失败会按「每个客户端连接」重复触发：tgnet 断线重连时可能每秒好几条。
        # 真机日志里同一条 Errno 7 出现过 18666 次（2.4 MB），把有用信息全淹了。
        # 这里按 (host, 原因) 每分钟最多记一条，中间的被压掉并汇总到下一行。
        self._fail_log = {}
        self._close_log = {}
        self.dial_failures = 0
        self.max_tunnels = MAX_TUNNELS       # 并发隧道上限（防御性）
        self.keepalive_interval = KEEPALIVE_INTERVAL
        self.log = logger

    def set_max_tunnels(self, value):
        try:
            n = int(value)
        except Exception:
            return
        self.max_tunnels = max(16, min(512, n))

    def set_keepalive_interval(self, value):
        try:
            sec = float(value)
        except Exception:
            return
        if sec < 0:
            return
        # 0 = 关闭保活；上限 600s（再长就没有保持连接的意义了）
        self.keepalive_interval = min(600.0, sec)

    # ---- 配置 ----
    def configure(self, domain, use_tls, conn_hash, user_agent, insecure_tls, port,
                  labels=None):
        with self._lock:
            self.domain = (domain or "").strip()
            self.labels = dict(labels) if isinstance(labels, dict) and labels \
                else dict(DC_SUBDOMAINS)
            self.use_tls = bool(use_tls)
            self.conn_hash = conn_hash if conn_hash is not None else DEFAULT_CONN_HASH
            self.user_agent = user_agent or PLUGIN_UA
            self.insecure_tls = bool(insecure_tls)
            self.port = int(port)
            self.table, self.v6_prefix = build_routes(self.domain, self.labels)

    # ---- 生命周期 ----
    @property
    def running(self):
        return self._server_sock is not None

    def start(self):
        with self._lock:
            if self._server_sock is not None:
                return True
            if not self.domain:
                self.last_error = "「域名」未填写"
                self.log("未填写「域名」：没有可用的子域名，代理未启动"
                         "（协议本身不需要内置域名，请填你自己的）")
                return False
            if not self.table:
                self.configure(self.domain, self.use_tls, self.conn_hash,
                               self.user_agent, self.insecure_tls, self.port,
                               self.labels)
            # 端口刚被 stop() 释放时，内核可能还要一小会儿才彻底回收，
            # 真机日志出现过「tcp2ws stopped」之后紧接着
            # 「bind 127.0.0.1:6356 failed: [Errno 98] Address already in use」——
            # 表现为关掉再打开代理就没起来。这里退避重试几次。
            srv = None
            last_err = None
            for attempt in range(6):
                try:
                    srv = socket.socket(socket.AF_INET, socket.SOCK_STREAM)
                    srv.setsockopt(socket.SOL_SOCKET, socket.SO_REUSEADDR, 1)
                    srv.bind(("127.0.0.1", self.port))
                    srv.listen(64)
                    srv.settimeout(1.0)
                    break
                except OSError as e:
                    last_err = e
                    try:
                        srv.close()
                    except Exception:
                        pass
                    srv = None
                    if getattr(e, "errno", None) != 98 or attempt == 5:   # 98 = EADDRINUSE
                        break
                    time.sleep(0.2 * (attempt + 1))
            if srv is None:
                self.last_error = "bind 127.0.0.1:%d failed: %s" % (self.port, last_err)
                self.log(self.last_error)
                return False
            self._server_sock = srv
            self._stopping.clear()
            self._accept_thread = threading.Thread(
                target=self._accept_loop, name="wsproxy-accept", daemon=True)
            self._accept_thread.start()
            first = (self.labels or DC_SUBDOMAINS).get(1, "?")
            self.log("tcp2ws listening on 127.0.0.1:%d -> *.%s (tls=%s, DC1 标签=%s)"
                     % (self.port, self.domain, self.use_tls, first))
            return True

    def stop(self):
        with self._lock:
            self._stopping.set()
            srv = self._server_sock
            self._server_sock = None
            accept_thread = self._accept_thread
            self._accept_thread = None
            tunnels = list(self._tunnels)
        if srv is not None:
            # 顺序很重要：accept() 可能正阻塞在这个 fd 上，
            # 那个 in-flight 的系统调用会继续持有内核 socket，
            # 于是端口不会立刻释放（紧接着 start() 就 EADDRINUSE）。
            # 先 shutdown 让阻塞的 accept 尽快返回，再 close。
            try:
                srv.shutdown(socket.SHUT_RDWR)
            except Exception:
                pass
            try:
                srv.close()
            except Exception:
                pass
        if accept_thread is not None and accept_thread.is_alive():
            # accept 有 1s 超时，最多等它轮询到 _stopping；等到了端口才算干净
            try:
                accept_thread.join(1.5)
            except Exception:
                pass
        for client, ws in tunnels:
            try:
                ws.close()
            except Exception:
                pass
            try:
                client.close()
            except Exception:
                pass
        self.log("tcp2ws stopped (tore down %d tunnels)" % len(tunnels))

    # ---- accept ----
    def _accept_loop(self):
        while not self._stopping.is_set():
            try:
                client, _addr = self._server_sock.accept()
            except socket.timeout:
                continue
            except OSError:
                break
            except Exception as e:  # 防 accept 线程静默死亡
                self.last_error = "accept error: %s" % e
                self.log(self.last_error)
                time.sleep(0.1)
                continue
            threading.Thread(target=self._handle_client_safe,
                             args=(client,), name="wsproxy-client",
                             daemon=True).start()

    def _handle_client_safe(self, client):
        try:
            self._handle_client(client)
        except Exception as e:
            self.last_error = "session error: %s" % e
        finally:
            # tunnels_open 的递减由 _handle_client 自己负责（只有真正占用了
            # 名额的路径才递减）。这里只负责关掉客户端 socket。
            try:
                client.close()
            except Exception:
                pass

    # ---- SOCKS5 ----
    def _handle_client(self, client):
        client.settimeout(15.0)
        try:
            client.setsockopt(socket.IPPROTO_TCP, socket.TCP_NODELAY, 1)
        except Exception:
            pass
        ver = _recv_exact(client, 1)[0]
        if ver != 0x05:
            raise WsError("not socks5 (ver=%d)" % ver)
        nmethods = _recv_exact(client, 1)[0]
        methods = _recv_exact(client, nmethods)
        if 0x00 in methods:
            client.sendall(b"\x05\x00")
        elif 0x02 in methods:
            client.sendall(b"\x05\x02")
            self._socks5_auth(client)  # 透传接受任意凭据
        else:
            client.sendall(b"\x05\xff")
            return

        hdr = _recv_exact(client, 4)
        _ver, cmd, _rsv, atyp = hdr[0], hdr[1], hdr[2], hdr[3]
        if atyp == 0x01:
            target = socket.inet_ntoa(_recv_exact(client, 4))
        elif atyp == 0x04:
            target = socket.inet_ntop(socket.AF_INET6, _recv_exact(client, 16))
        elif atyp == 0x03:
            dlen = _recv_exact(client, 1)[0]
            target = _recv_exact(client, dlen).decode("idna", "replace")
        else:
            self._socks5_reply(client, 0x08)
            return
        _port = struct.unpack(">H", _recv_exact(client, 2))[0]

        if cmd != 0x01:  # 只支持 CONNECT
            self._socks5_reply(client, 0x07)
            return

        server = lookup_server(target, self.table, self.v6_prefix)
        if server is None:
            # 可诊断的拒绝优于静默误路由（见路由表设计原则）
            self.log("no ws upstream for %s, refusing the tunnel" % target)
            self._socks5_reply(client, 0x04)
            return

        # 并发上限：上游异常时 tgnet 会不断重连，这里做个兜底，
        # 避免线程/隧道无界增长（超过上限就明确拒绝，让上层自己去重试）。
        with self._lock:
            if self.tunnels_open >= self.max_tunnels:
                over_limit = True
            else:
                over_limit = False
                self.tunnels_open += 1
                self.tunnels_total += 1
        if over_limit:
            self.last_error = ("too many tunnels (%d/%d), refusing %s"
                               % (self.tunnels_open, self.max_tunnels, server))
            self._socks5_reply(client, 0x05)
            return
        # 从这里开始，tunnels_open 已由本函数占用；无论下面走哪条路径
        # （拨号失败、被拒绝、桥接结束、抛异常）都必须且只能释放一次。
        # 注意 _handle_client_safe 不再递减计数——早先两边都减，会把
        # 计数减穿，导致并发上限形同虚设（测试实测：被拒绝的连接把
        # 计数从 1 减到 0，之后所有连接都被放行）。
        try:
            ws_sock = None
            leftover = b""
            last_err = None
            # 单次 ws_connect 已含「TCP + TLS + Upgrade」，最多试 2 次，
            # 避免最坏耗时翻倍撞上 tgnet 的代理连接超时。
            for _attempt in (1, 2):
                try:
                    ws_sock, leftover = ws_connect(
                        server, self.use_tls, self.user_agent, self.conn_hash,
                        timeout=3.0, insecure=self.insecure_tls)
                    break
                except Exception as e:
                    last_err = e
                    # 上游明确拒绝（HTTP 4xx）时重试没有意义，直接失败并退避
                    if self._dial_error_kind(e) == "rejected":
                        break
            if ws_sock is None:
                self._log_dial_failure(server, last_err)
                self._socks5_reply(client, 0x05)
                return

            self._socks5_reply(client, 0x00)
            client.settimeout(None)
            self._bridge(client, WsConn(ws_sock, leftover), server)
        finally:
            with self._lock:
                self.tunnels_open = max(0, self.tunnels_open - 1)

    # ---- 失败诊断（限流 + 说人话） ----
    DIAL_LOG_INTERVAL = 60.0   # 同一 (host, 原因) 每 60 秒最多记一条

    @staticmethod
    def _dial_error_kind(err):
        """把底层异常归成 resolve / tls / timeout / other，便于给出对症提示。"""
        text = str(err or "").lower()
        if isinstance(err, socket.gaierror) or "no address associated" in text \
                or "name or service not known" in text \
                or "temporary failure in name resolution" in text:
            return "resolve"
        if isinstance(err, ssl.SSLError) or "certificate" in text or "ssl" in text:
            return "tls"
        # HTTP 非 101：403/404/426/302 这类是上游明确拒绝，不是瞬时故障，
        # 立刻重试只会放大（这类应交给上层退避，而不是马上再来一次）。
        if "handshake rejected" in text or "http " in text and "40" in text:
            return "rejected"
        if isinstance(err, (socket.timeout, TimeoutError)) or "timed out" in text \
                or "timeout" in text:
            return "timeout"
        return "other"

    def _log_dial_failure(self, server, err):
        kind = self._dial_error_kind(err)
        self.last_error = "ws dial %s failed: %s" % (server, err)
        now = time.time()
        with self._lock:
            self.dial_failures += 1
            last_ts, suppressed = self._fail_log.get((server, kind), (0.0, 0))
            if now - last_ts < self.DIAL_LOG_INTERVAL:
                self._fail_log[(server, kind)] = (last_ts, suppressed + 1)
                return
            self._fail_log[(server, kind)] = (now, 0)
        tail = "" if not suppressed else "（同一条失败已略过 %d 条）" % suppressed
        trace = LAST_DIAL_TRACE
        if kind == "resolve":
            self.log("子域名解析失败：%s —— 本机 DNS 查不到这个域名%s" % (server, tail))
            self.log("常见原因：「域名 / 子域标签」改过，而 Cloudflare 里的 DNS 记录还是旧的；"
                     "去设置页点「复制 DNS 记录到剪贴板」，重新 Import 一遍")
        elif unreachable_hint(err):
            # 能解析、但连不出去：要么 IP 不可路由（DNS 被污染），要么网络本身不通
            self.log("ws dial %s 连不上：%s%s" % (server, trace or err, tail))
            self.log("本机解析到的是这些地址，但一个都连不上（Network is unreachable）。"
                     "若这些不是 Cloudflare 的 IP，说明本机 DNS 被污染："
                     "把 App 设置 → 通用 →「DNS 解析器」从 System 改成任一 DoH 项即可绕过；"
                     "若改了仍失败，请检查网络本身是否不通")
        elif kind == "timeout":
            self.log("ws dial %s 超时：%s%s" % (server, trace or err, tail))
        else:
            self.log("ws dial %s failed: %s%s" % (server, trace or err, tail))

    @staticmethod
    def _socks5_auth(client):
        # RFC1929：接受任意用户名/密码
        _ver = _recv_exact(client, 1)[0]
        ulen = _recv_exact(client, 1)[0]
        _recv_exact(client, ulen)
        plen = _recv_exact(client, 1)[0]
        _recv_exact(client, plen)
        client.sendall(b"\x01\x00")

    @staticmethod
    def _socks5_reply(client, code):
        client.sendall(b"\x05" + bytes([code]) + b"\x00\x01\x00\x00\x00\x00\x00\x00")

    # ---- 双向转发 ----
    def _bridge(self, client, ws, server):
        started = time.time()
        done = threading.Event()
        stats = {"c2w": 0, "w2c": 0, "by": None, "head": b"", "close": None,
                 "init": b"", "last_io": time.time(), "last_read": time.time(),
                 "pings": 0}

        with self._lock:
            self._tunnels.add((client, ws))

        def client_to_ws():
            try:
                while not done.is_set():
                    data = client.recv(32768)
                    if not data:
                        if stats["by"] is None:
                            stats["by"] = "client-eof"
                        break
                    if stats["c2w"] < 64:
                        # 前 64B 是 obfs2 init（tgnet 经 SOCKS5 也走混淆），
                        # 留存以便关闭时解码入向头部
                        stats["init"] += data[:64 - stats["c2w"]]
                    stats["c2w"] += len(data)
                    stats["last_io"] = time.time()
                    ws.send_binary(data)
            except Exception as e:
                if stats["by"] is None:
                    stats["by"] = "client-err:%s" % type(e).__name__
            finally:
                done.set()

        t = threading.Thread(target=client_to_ws, name="wsproxy-c2w", daemon=True)
        t.start()

        def keepalive():
            """空闲时发 WS ping：上游（CF 回源 / DC）会回收空闲连接，
            真机日志里大量隧道正是这样被 "unexpected eof" 掐断的。

            只在「既没有收到字节、也没有发出字节」时才 ping，所以
            Telegram 自己一直在跑数据时不会产生额外流量/唤醒。
            """
            interval = self.keepalive_interval
            if interval <= 0:
                return                            # 保活被设置页关掉了
            while not done.wait(interval):
                now = time.time()
                if now - stats["last_io"] < interval:
                    continue                      # 双向都在动，不用保活
                if now - max(stats["last_read"], getattr(ws, "last_read", 0.0)) \
                        > KEEPALIVE_IDLE_LIMIT:
                    if stats["by"] is None:
                        stats["by"] = "keepalive-timeout"
                    break
                try:
                    ws.send_ping()
                except Exception as e:
                    if stats["by"] is None:
                        stats["by"] = "keepalive-err:%s" % type(e).__name__
                    break
                stats["pings"] += 1

        kt = threading.Thread(target=keepalive, name="wsproxy-keepalive", daemon=True)
        kt.start()
        try:
            while not done.is_set():
                kind, payload = ws.recv_message()
                if kind == "closed":
                    if stats["by"] is None:
                        stats["by"] = "server-close"
                    if payload:
                        # close 帧载荷（2B 状态码 + 原因），
                        # 如 DC 拒绝时会带 "        404\x00" 这类原因串
                        stats["close"] = payload[:32]
                    break
                stats["last_read"] = time.time()
                stats["last_io"] = stats["last_read"]
                if payload:
                    if stats["w2c"] < 64:
                        # 保留首批入向字节：早夭隧道的头部往往就是
                        # abridged 传输错误包（如 01 6c fe ff ff = -404）
                        stats["head"] += payload[:64 - stats["w2c"]]
                    stats["w2c"] += len(payload)
                    client.sendall(payload)
        except Exception as e:
            if stats["by"] is None:
                stats["by"] = "server-err:%s" % (str(e) or type(e).__name__)[:48]
        finally:
            done.set()
            ws.close()
            try:
                client.shutdown(socket.SHUT_RDWR)
            except Exception:
                pass
            with self._lock:
                self._tunnels.discard((client, ws))
            age = time.time() - started
            extra = ""
            if 0 < stats["w2c"] <= 64:
                # 早夭小流量隧道：尝试用留存的 obfs2 init 解码入向头部，
                # 读出 abridged 传输错误码（如 -404）；解不出则只给密文 hex
                extra += " w2c_head=%s" % stats["head"].hex()
                plain = None
                try:
                    plain = obfs2_decode_incoming(stats["init"], stats["head"])
                except Exception:
                    plain = None
                if plain is not None:
                    err = parse_abridged_err(plain, stats["w2c"])
                    if err:
                        extra += " mt_err=%d" % err
                    else:
                        extra += " w2c_plain=%s" % plain.hex()
            if stats["close"]:
                extra += " close=%s" % stats["close"].hex()
            self._log_tunnel_close(server, stats["by"], age, stats["c2w"],
                                   stats["w2c"], extra)

    # 隧道关闭日志：同一 (子域名, 原因) 每 5 秒最多一条，其余只计数。
    # 真机一次会话 27 秒关了 40 条隧道，刷太快反而看不出问题。
    CLOSE_LOG_INTERVAL = 5.0

    def _log_tunnel_close(self, server, by, age, c2w, w2c, extra):
        now = time.time()
        key = (server, by)
        with self._lock:
            last_ts, suppressed = self._close_log.get(key, (0.0, 0))
            if now - last_ts < self.CLOSE_LOG_INTERVAL:
                self._close_log[key] = (last_ts, suppressed + 1)
                return
            self._close_log[key] = (now, 0)
        tail = "" if not suppressed else "（同类关闭已略过 %d 条）" % suppressed
        self.log("tunnel %s closed by=%s age=%.1fs c2w=%dB w2c=%dB%s%s"
                 % (server, by, age, c2w, w2c, extra, tail))


# ---------------------------------------------------------------------------
# Telegram 代理注册（org.telegram.messenger.SharedConfig）
# ---------------------------------------------------------------------------
class TelegramProxyBridge(object):
    """把本机 SOCKS5 端口注册为 Telegram 的当前代理；禁用时移除。"""

    def __init__(self, logger):
        self.log = logger
        self._proxy_info = None

    @staticmethod
    def _classes():
        SharedConfig = jclass("org.telegram.messenger.SharedConfig")
        ProxyInfo = jclass("org.telegram.messenger.SharedConfig$ProxyInfo")
        NotificationCenter = jclass("org.telegram.messenger.NotificationCenter")
        return SharedConfig, ProxyInfo, NotificationCenter

    def enable(self, port):
        try:
            SharedConfig, ProxyInfo, NotificationCenter = self._classes()
            info = ProxyInfo("127.0.0.1", int(port), "", "", "")
            added = SharedConfig.addProxy(info)
            if added is None:
                added = info
            SharedConfig.setCurrentProxy(added)
            SharedConfig.setProxyEnable(True)
            self._proxy_info = added

            def notify():
                try:
                    NotificationCenter.getGlobalInstance().postNotificationName(
                        NotificationCenter.proxySettingsChanged)
                except Exception:
                    pass
            run_on_ui_thread(notify)
            self.log("registered socks5 proxy 127.0.0.1:%d" % port)
            return True
        except Exception as e:
            self.log("register proxy failed: %s" % e)
            return False

    def disable(self):
        try:
            SharedConfig, _ProxyInfo, NotificationCenter = self._classes()
            try:
                SharedConfig.setProxyEnable(False)
            except Exception:
                pass
            if self._proxy_info is not None:
                try:
                    SharedConfig.deleteProxy(self._proxy_info)
                except Exception:
                    pass
                self._proxy_info = None

            def notify():
                try:
                    NotificationCenter.getGlobalInstance().postNotificationName(
                        NotificationCenter.proxySettingsChanged)
                except Exception:
                    pass
            run_on_ui_thread(notify)
        except Exception as e:
            self.log("unregister proxy failed: %s" % e)


# ---------------------------------------------------------------------------
# 插件入口
# ---------------------------------------------------------------------------
# TG 代理列表那一行显示的名字（默认就是插件名）。留空则不改，仍显示 127.0.0.1:端口。
PROXY_ROW_NAME = "WebSocket 代理"
# 承载那一行的内部类；不同 fork 命名可能不同，依次尝试
PROXY_CELL_CLASSES = [
    "org.telegram.ui.ProxyListActivity$TextDetailProxyCell",
    "org.telegram.ui.ProxyListActivity$ProxyCell",
]


class WsProxyPlugin(BasePlugin):

    # ---- 生命周期 ----
    def on_plugin_load(self):
        self._relay = Relay(self.log)
        self._bridge = TelegramProxyBridge(self.log) if _IN_HOST else None
        self._row_unhook = None
        self._apply_config()
        if _IN_HOST:
            try:
                self._install_proxy_row_hook()
            except Exception as e:
                self.log("安装代理列表改名 hook 失败（已忽略）: %s" % e)
        if self.get_setting("enabled", False):
            self._start()

    def on_plugin_unload(self):
        try:
            if getattr(self, "_row_unhook", None) is not None:
                self._row_unhook()
                self._row_unhook = None
        except Exception:
            pass
        self._stop()

    def on_app_event(self, event_type):
        if str(event_type) == "app_start" and self.get_setting("enabled", False):
            if not getattr(self, "_relay", None) or not self._relay.running:
                try:
                    self._apply_config()
                    self._start()
                except Exception as e:
                    self.log("restart on app_start failed: %s" % e)

    # ---- 配置 ----
    def _effective_domain(self):
        """「域名」里填的域名（必填）。"""
        return (self.get_setting("domain", "") or "").strip()

    def _label_salt(self):
        """盐值：只使用设置里显式填写的值，绝不自动生成。

        1.3.0 曾在这里生成随机盐并写回设置；一旦宿主设置没持久化（或用户重装插件），
        标签每次启动都会变，DNS 立刻全部失配、表现就是"插件不能用"。
        1.3.1 起留空 = 只按域名派生，永远稳定；需要换标签时再手动填盐值。
        """
        salt = (self.get_setting("label_salt", "") or "").strip()
        self._salt_cache = salt
        return salt

    def _label_mode(self):
        """当前生效的起名模式：0 自动生成 / 1 经典名 / 2 自定义。"""
        try:
            return int(self.get_setting("label_mode", 0) or 0)
        except Exception:
            return 0

    def _labels(self):
        return build_labels(
            self._effective_domain(),
            self._label_mode(),
            self._label_salt(),
            self.get_setting("label_custom", ""),
        )

    # ---- TG 代理列表改名（可选能力；宿主没有 hook API 时自动跳过）----
    def _install_proxy_row_hook(self):
        """把 TG 代理列表那一行的 127.0.0.1:端口 显示成名字。

        TG 的 ProxyListActivity$TextDetailProxyCell.setProxy() 里写死了
        textView.setText(address + ":" + port)，ProxyInfo 没有"名字"字段；
        Nullgram 是靠改 app 源码给自家内置代理加特判。插件这边用宿主提供的
        Xposed 式 hook，在 setProxy 之后覆写这个 TextView，效果一样且不动 app。
        """
        self._row_unhook = None
        if not _HOOKS_OK:
            self.log("代理列表改名：宿主未提供 hook API，已跳过（列表仍显示 127.0.0.1:端口）")
            return False
        for cname in PROXY_CELL_CLASSES:
            try:
                cls = hook_utils.find_class(cname)
            except Exception:
                cls = None
            if cls is None:
                continue
            try:
                methods = cls.getDeclaredMethods()
            except Exception:
                continue
            for i in range(len(methods)):
                try:
                    m = methods[i]
                    if m.getName() != "setProxy" or len(m.getParameterTypes()) != 1:
                        continue
                    m.setAccessible(True)
                    try:
                        hook = XposedHook(after=self._after_proxy_cell_set_proxy)
                    except TypeError:
                        hook = XposedHook(None, self._after_proxy_cell_set_proxy)
                    unhook = self.hook_method(m, hook)
                    if unhook is not None:
                        self._row_unhook = unhook
                        self.log("代理列表改名已启用：%s.setProxy -> %s"
                                 % (cname, self.get_setting("proxy_row_name", PROXY_ROW_NAME)))
                        return True
                except Exception as e:
                    self.log("hook setProxy 失败: %s" % e)
        self.log("代理列表改名：没找到 ProxyCell.setProxy，已跳过（列表仍显示 127.0.0.1:端口）")
        return False

    def _after_proxy_cell_set_proxy(self, param):
        """setProxy() 之后：若这一行是插件注册的本机代理，就把标题换成名字。"""
        try:
            name = (self.get_setting("proxy_row_name", PROXY_ROW_NAME) or "").strip()
            if not name:
                return
            relay = getattr(self, "_relay", None)
            if relay is None:
                return
            info = param.args[0]
            try:
                addr, port = info.address, info.port
            except Exception:
                addr = hook_utils.get_private_field(info, "address")
                port = hook_utils.get_private_field(info, "port")
            if str(addr) != "127.0.0.1" or port is None or int(port) != int(relay.port):
                return
            try:
                view = hook_utils.get_private_field(param.thisObject, "textView")
            except Exception:
                view = None
            if view is None:
                view = getattr(param.thisObject, "textView", None)
            if view is not None:
                view.setText(name)
        except Exception:
            pass

    def _dns_records_text(self):
        """可直接导入 Cloudflare 的 zone 片段（BIND 格式，只保留最少注释）。

        注意：这段文本会被整段粘进文件再上传，所以任何一行多余内容都可能
        让人以为"导入失败"，这里刻意不写逐条说明（原理见 README）。
        """
        domain = self._effective_domain()
        if not domain:
            return ""
        labels = self._labels()
        lines = [
            "; ws_proxy DNS records for %s" % domain,
            "; Cloudflare Import: tick Proxy (orange cloud); SSL/TLS mode must be Flexible",
        ]
        for dc in LABEL_DOMAIN_DCS:
            for ip in DC_RECORDS[dc][1]:
                lines.append("%s.%s.\t1\tIN\tA\t%s" % (labels[dc], domain, ip))
        for dc in LABEL_DOMAIN_DCS:
            for ip in DC_RECORDS[dc][2]:
                lines.append("%s.%s.\t1\tIN\tAAAA\t%s" % (labels[dc], domain, ip))
        return "".join(line + "\n" for line in lines)

    def _log_dns_selfcheck(self):
        """把「本机解析当前 DC1 子域名得到哪些 IP」写进日志。

        这是排查「代理连不上」最快的一条线索：
          - 解析失败        -> 十有八九是 DNS 记录与当前子域名不一致（重新 Import）；
          - IP 不是 Cloudflare 的（104.21/172.67/104.16/172.64 等）
                            -> 本机 DNS 被污染，此时 getaddrinfo 不报错、
                               连不上时报 ENETUNREACH，把 App 的「DNS 解析器」改成 DoH 即可绕过。
        """
        try:
            domain = self._effective_domain()
            if not domain:
                return
            host = "%s.%s" % (self._labels().get(1, "?"), domain)
            addrs, err = system_addrs(host, 443)
            if addrs:
                self.log("DNS 自检：%s -> %s" % (host, ", ".join(addrs[:4])))
            else:
                self.log("DNS 自检：%s 解析失败（%s）；已在用 App 的「DNS 解析器」，"
                         "可把它改成任一 DoH 项以绕过本机 DNS" % (host, err))
        except Exception:
            pass

    def _apply_config(self):
        self._salt_cache = None
        port_raw = self.get_setting("listen_port", str(DEFAULT_PORT))
        try:
            port = int(str(port_raw).strip())
            if not (1 <= port <= 65535):
                port = DEFAULT_PORT
        except Exception:
            port = DEFAULT_PORT
        # 保活间隔（0 = 关闭）：设置页给的是整数秒，解析失败就退回默认值
        try:
            ka = float(str(self.get_setting("keepalive_interval",
                                            int(KEEPALIVE_INTERVAL))).strip())
        except Exception:
            ka = KEEPALIVE_INTERVAL
        self._relay.set_keepalive_interval(ka)
        domain = self._effective_domain()
        labels = self._labels()
        self._relay.configure(
            domain=domain,
            use_tls=bool(self.get_setting("tls", True)),
            conn_hash=self.get_setting("conn_hash", DEFAULT_CONN_HASH),
            user_agent=self.get_setting("user_agent", PLUGIN_UA) or PLUGIN_UA,
            insecure_tls=bool(self.get_setting("insecure_tls", False)),
            port=port,
            labels=labels,
        )
        if domain:
            self.log("子域名(DC1-5)：%s" % "  ".join(
                "%s.%s" % (labels[dc], domain) for dc in (1, 2, 3, 4, 5)))
            self.log("提示：设置页「复制 DNS 记录到剪贴板」可直接复制完整记录")
            # 后台线程做一次解析自检：getaddrinfo 没有超时参数，绝不能卡住插件队列
            try:
                threading.Thread(target=self._log_dns_selfcheck, daemon=True).start()
            except Exception:
                pass
        else:
            self.log("「域名」尚未填写：代理不会启动，请先填你自己的域名")

    def _start(self):
        if not self._relay.running:
            if not self._relay.start():
                return
        if self._bridge is not None:
            self._bridge.enable(self._relay.port)

    def _stop(self):
        try:
            if self._bridge is not None:
                self._bridge.disable()
        except Exception:
            pass
        try:
            self._relay.stop()
        except Exception:
            pass

    def _restart(self):
        was_enabled = bool(self.get_setting("enabled", False))
        self._stop()
        self._apply_config()
        if was_enabled:
            self._start()

    # ---- 设置界面 ----
    def create_settings(self):
        def on_toggle_enabled(*_a):
            if self.get_setting("enabled", False):
                self._apply_config()
                self._start()
            else:
                self._stop()

        def on_restart(*_a):
            self._restart()

        def on_label_mode_change(*_a):
            on_restart()
            # 尽量让宿主重建这一页，好按所选「子域标签」显示对应输入框。
            # 宿主若不支持 reload_settings，退出再进一次设置页同样生效。
            try:
                self.set_setting("label_mode", self.get_setting("label_mode", 0),
                                 reload_settings=True)
            except Exception:
                pass

        # 宿主在 loadPluginSettings() 里按 dataclass 反射构造这些设置项：只
        # 要传了它不认识的参数就抛 TypeError，而异常会终结整页设置加载，
        # 日志里表现为「Failed to load plugin settings」+
        # 「Selector.__init__() got an unexpected keyword argument 'subtext'」
        # （Selector 没有 subtext，Switch/Input/Text 才有）。这里统一兜底：
        # 丢弃宿主不支持的参数，而不是把整页设置弄没。
        def item(factory, **kw):
            try:
                return factory(**kw)
            except TypeError:
                try:
                    import inspect
                    allowed = inspect.signature(factory).parameters
                    kw = dict((k, v) for k, v in kw.items() if k in allowed)
                except Exception:
                    kw.pop("subtext", None)
                return factory(**kw)

        mode = self._label_mode()
        rows = [
            item(Header, text="WebSocket 代理"),
            item(Switch, key="enabled", text="启用代理", default=False,
                   subtext="开启后本机 127.0.0.1 会监听端口，并把 Telegram 的流量转到你的域名",
                   on_change=lambda *a: on_toggle_enabled()),
            item(Input, key="domain", text="域名", default="",
                  subtext="必填。只填域名本身：不要 http://，不要带子域名（例如 example.com）；"
                          "建议用最外层域名，Cloudflare 的免费证书就能覆盖下面的子域名",
                  on_change=lambda *a: on_restart()),
            item(Selector, key="label_mode", text="子域标签", default=0,
                     items=LABEL_MODES,
                     on_change=lambda *a: on_label_mode_change()),
        ]
        if mode == 0:
            rows.append(item(Input, key="label_salt", text="子域名随机串（留空即可）", default="",
                              subtext="留空：按「域名」自动算出子域名，重启/重装都不变（推荐）。"
                                      "填一串随机字符：换成另一套子域名（更难被猜），"
                                      "但改它=换子域名，DNS 记录要跟着重配；"
                                      "里面已有 16 位十六进制是旧版本自动生成的，清空同样会换子域名",
                              on_change=lambda *a: on_restart()))
        elif mode == 2:
            rows.append(item(Input, key="label_custom", text="自定义子域名", default="",
                              subtext="按 DC1,DC2,DC3,DC4,DC5 的顺序用英文逗号分隔；"
                                      "示例：aa1（没写的会自动生成，只填 1 个也行）",
                              on_change=lambda *a: on_restart()))
        dns_text = self._dns_records_text()
        if dns_text:
            # 记录文本必须整段带走，所以这里不用 Input：Input 点开的是宿主的
            # 「单行」输入框（PluginSettingsActivity.showStringInputDialog，
            # TYPE_CLASS_TEXT 且没有 MULTI_LINE），换行在复制时会被 Android 的
            # SingleLineTransformationMethod 换成空格 —— 粘到 Cloudflare 就只剩
            # 一行，Import 必然失败。
            # 因此改成两条：Text 一键写剪贴板（不走 TextView，换行原样保留），
            # EditText(multiline) 供查看/手动选择（宿主 PluginEditTextCell 会
            # setSingleLine(false)，换行同样保留）。
            dns_key = "dns_copy_" + hashlib.sha1(dns_text.encode("utf-8")).hexdigest()[:8]
            if Text is not None and copy_to_clipboard is not None:
                rows.append(item(Text,
                    text="复制 DNS 记录到剪贴板",
                    subtext="点一下即可；已保留换行，可直接粘进 .txt 再上传",
                    accent=True,
                    on_click=lambda *a: copy_to_clipboard(dns_text)))
            if EditText is not None:
                rows.append(item(EditText,
                    key=dns_key,
                    hint="DNS 记录（可长按全选复制）",
                    default=dns_text,
                    multiline=True,
                    max_length=8192))
            else:
                # 老宿主没有 EditText：退回原来的 Input，至少还能看到内容
                rows.append(item(Input,
                    key=dns_key,
                    text="DNS 记录（点开复制）",
                    default=dns_text,
                    subtext="整段复制 → Cloudflare → DNS → Records → Import（勾选橙云）",
                    on_change=lambda *a: None))
        rows += [
            item(Divider),
            item(Header, text="高级（一般不用改）"),
            item(Input, key="conn_hash", text="Conn-Hash", default=DEFAULT_CONN_HASH,
                  subtext="只有自建 Pages/Workers 中继时才需要，要跟中继里的值一致",
                  on_change=lambda *a: on_restart()),
            item(Input, key="proxy_row_name", text="代理列表里显示的名字", default=PROXY_ROW_NAME,
                  subtext="TG 代理列表那一行写死了显示 127.0.0.1:端口；填这里会覆盖它"
                          "（留空=不改，仍显示地址）",
                  on_change=lambda *a: on_restart()),
            item(Input, key="user_agent", text="User-Agent", default=PLUGIN_UA,
                  subtext="一般保持默认；万一上游返回 302/拒绝，可换成 Telegram Web 的 UA 再试",
                  on_change=lambda *a: on_restart()),
            item(Switch, key="tls", text="使用 TLS（wss）", default=True,
                   subtext="Cloudflare 部署必须开启",
                   on_change=lambda *a: on_restart()),
            item(Input, key="listen_port", text="本机端口", default=str(DEFAULT_PORT),
                  subtext="插件在本机监听的 SOCKS5 端口，默认 6356",
                  on_change=lambda *a: on_restart()),
            item(Input, key="keepalive_interval", text="空闲保活间隔（秒）",
                  default=str(int(KEEPALIVE_INTERVAL)),
                  subtext="空闲超过这个时间就给上游发一个 WebSocket ping，避免连接被"
                          "空闲回收（日志里的 server-err:unexpected eof）。填 0 关闭，默认 25 秒",
                  on_change=lambda *a: on_restart()),
            item(Switch, key="insecure_tls", text="跳过证书校验", default=False,
                   subtext="仅排障使用，存在安全风险",
                   on_change=lambda *a: on_restart()),
        ]
        return rows
