# -*- coding: utf-8 -*-
"""
WS Proxy —— 让 Telegram 的流量改走 WebSocket(wss)，绕过部分网络的封锁。
移植自 Nullgram / Nekogram 的 tcp2ws，采用「纯 DNS 模式」：不需要服务器。

三步就能用：
  1. 「域名」填你自己的域名（必填，例如 example.com）；
  2. 点一下「复制 DNS 记录到剪贴板」，粘到电脑上存成 .txt，
     在 Cloudflare 里 Import（勾橙云），
     再把 Cloudflare 的 SSL/TLS 加密模式设为 Flexible；
  3. 打开「启用代理」，然后去 Telegram 的代理列表里启用它。

细节（原理、标签派生、路由表、部署与排错）见同目录 README.md。
依赖：仅 Python 标准库，不需要第三方包。
"""

__id__ = "ws_proxy"
__name__ = "WebSocket 代理"
__description__ = (
    "让 Telegram 的流量改走 WebSocket(wss)，绕过部分网络的封锁。"
    "纯客户端方案：只需要一个你自己的域名，不需要任何服务器。"
    "在设置页填好域名、按提示配好 DNS 记录后打开开关即可使用。"
)
__author__ = "ljili (port of qwq233/Nullgram)"
__version__ = "1.3.21"

