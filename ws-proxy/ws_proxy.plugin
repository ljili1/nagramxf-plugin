# -*- coding: utf-8 -*-
"""
WS Proxy (tcp2ws) — Nullgram 的 WebSocket 代理功能移植为 NagramXF 插件。

原理（与 Nullgram 内置实现一致）：
  1. 在本机 127.0.0.1 起一个 SOCKS5 服务；
  2. tgnet 拨到哪个 Telegram DC 地址，就按路由表把该地址映射到对应的
     Cloudflare 子域（pluto/venus/aurora/vesta/flora.<域名>）；
  3. 与该子域的 /api 建立 WebSocket（wss，子协议 binary），
     TCP 字节流 <-> WS 二进制帧 双向转发；
  4. 插件自动向 Telegram 代理列表注册 127.0.0.1:<端口> 的 SOCKS5 代理并启用。

路由表来源：qwq233/Nullgram libs/tcp2ws + docs/wsproxy/records.txt，
并合入了以下修正：
  - 补 149.154.167.41（dc2 -> venus）精确行；
  - dc4/dc5 的 IPv6 /64 前缀键（Telegram 会下发同块的 ::b 等未登记主机）；
  - 查表失败时按 SOCKS5 "Host unreachable" 拒绝（不回退裸 IP：
    裸 IP 的 wss 因 SNI 问题不可用，拒绝更快且更可诊断）。

依赖：仅 Python 标准库（socket / ssl / threading），不需要第三方包。
"""

__id__ = "ws_proxy"
__name__ = "WS Proxy (tcp2ws)"
__description__ = (
    "将 Nullgram 的 tcp2ws WebSocket 代理移植为插件："
    "本机 SOCKS5 -> 按 DC 路由到 Cloudflare 子域 -> wss://<子域>/api。"
    "默认使用 Nullgram 公共域名，也可填自建域名。"
)
__author__ = "ljili (port of qwq233/Nullgram)"
__version__ = "1.0.0"

import base64
import ipaddress
import os
import socket
import ssl
import struct
import threading
import time

